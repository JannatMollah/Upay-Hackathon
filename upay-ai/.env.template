# ============================================================
# Upay AI — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env with real credentials to version control.
# ============================================================

# --- Server ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Authentication (REQUIRED — no default) ---
API_KEY=your-secure-api-key-here

# --- CORS (comma-separated allowed origins) ---
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=

# --- RBAC: Authorized nudge approvers (comma-separated IDs) ---
AUTHORIZED_APPROVERS=CM001,CM002,CM003,ADMIN001

# --- Database (Supabase PostgreSQL) ---
# IMPORTANT: Never hard-code credentials. Configure here only.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- Google Gemini API (for bilingual nudge generation) ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash

# --- Model & Data Paths ---
MODELS_DIR=./models
DATA_DIR=./data
MODEL_PATH=./models/xgboost_model.joblib
BASELINE_PATH=./models/baseline_lr.joblib
SURPLUS_MODEL_PATH=./models/surplus_regressor.joblib
SHAP_CACHE_PATH=./models/shap_values_test.npy
FEATURE_NAMES_PATH=./models/feature_names.json

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
